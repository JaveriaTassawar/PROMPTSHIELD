# Copy to .env and fill in. NEVER commit the real .env.

# --- Backend -----------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=sqlite:///./promptshield.db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES TO START with this placeholder when ENVIRONMENT is not
# "development", because a default signing key in a public repo would let
# anyone forge a token.
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Frontend dev servers allowed by CORS. Not a wildcard: "*" with
# credentials is rejected by browsers and would expose the API to any site.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML ----------------------------------------------------------------
# The 3-class classifier. The variable is PROMPTSHIELD_MODEL_PATH because
# ml/inference/classifier.py reads that name; app/core/config.py also
# accepts the older MODEL_PATH for compatibility.
#
# The checkpoint is ~268 MB and gitignored. Download it from the Drive
# link in ml/MODEL_CARD.md, or point this at your own.
PROMPTSHIELD_MODEL_PATH=./ml/models/run01_ck28371

# OPTIONAL. The 8-class attack sub-type model (ML Task 34, a stretch
# goal). Leave unset and the API still works -- classify() returns
# subtype=None rather than failing, and /api/analyze-prompt omits it.
#
# Note its measured limitation: it never predicts Role Override
# (0.00 F1, 0 of 18), so responses carry subtypeReliable=false for that
# case. See ml/MODEL_CARD.md section 19.7.
PROMPTSHIELD_SUBTYPE_MODEL_PATH=
