# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Python / backend / ml
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Env & secrets
.env
.env.local

# Databases
*.db
*.sqlite3

# ML data & models (kept local, too large for git)
# NOTE: the raw datasets live OUTSIDE this repo, at ../dataset/ (~1.6 GB).
# Nothing there is ever committed. These rules are a second line of defence
# in case anything gets copied into ml/data/.
ml/data/raw/
ml/data/processed/
# ...but class_weights.json is training CONFIG, not data. It is ~400 bytes
# and training/train.py loads it, so a fresh clone must have it.
!ml/data/processed/
ml/data/processed/*
!ml/data/processed/class_weights.json
ml/data/*.csv
ml/data/*.parquet
ml/data/*.json
ml/data/*.jsonl
ml/data/*.tsv
!ml/data/sample_1000.csv
ml/models/*.bin
ml/models/*.safetensors
ml/models/checkpoints/
# Trainer writes checkpoint shards (hundreds of MB each) to its output_dir.
# train.py defaults to ml/models/checkpoints/, but catch the common strays too
# so a smoke-test run can never push weights.
ml/training/checkpoints/
ml/training/runs/
**/checkpoint-*/
*.safetensors

# Hugging Face token — never commit
.huggingface/
hf_token*

# OS / editor
.DS_Store
.vscode/
